# Generated by packaging/build_release.py with a fixed source SHA-256.
# Experimental desktop support; no AUR publication is implied.
pkgname=rainshot
pkgver=@VERSION@
pkgrel=1
pkgdesc='Linux screenshot, floating annotation and local OCR tools'
arch=('any')
url='https://github.com/hstonc/rainshot'
license=('GPL-3.0-or-later')
depends=('python>=3.10' 'python-pyqt5' 'python-numpy' 'python-opencv'
         'python-atspi' 'qt5-svg' 'qt5-imageformats' 'qt5-wayland' 'libx11' 'libxi' 'libxtst' 'zbar' 'ffmpeg')
optdepends=('tesseract: local OCR' 'tesseract-data-eng: English OCR'
            'tesseract-data-chi_sim: Simplified Chinese OCR'
            'tesseract-data-chi_tra: Traditional Chinese OCR'
            'xdg-desktop-portal: Wayland screenshot portal')
source=("rainshot-${pkgver}-source.tar.gz::https://github.com/hstonc/rainshot/releases/download/v${pkgver}/rainshot-${pkgver}-source.tar.gz")
sha256sums=('@SHA256@')

package() {
    cd "$srcdir/rainshot-$pkgver"
    python packaging/install_tree.py --destdir "$pkgdir" --prefix /usr
}
